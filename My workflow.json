    {
      "parameters": {
        "jsCode": "// Keyword filter for working-student roles\nconst KEYWORDS = [\n  \"werkstudent\", \"werk-student\", \"werk student\",\n  \"working student\", \"working-student\", \"workingstudent\",\n  \"studentische hilfskraft\", \"studentische aushilfe\",\n  \"student assistant\", \"teilzeit\", \"werkstud\", \"werkst\"\n];\n\nfunction containsKeyword(text){\n  if(!text) return false;\n  const t = text.toLowerCase();\n  return KEYWORDS.some(k => {\n    const esc = k.replace(/[.*+?^${}()|[\\]\\\\]/g,\"\\\\$&\");\n    return new RegExp(\"\\\\b\" + esc + \"\\\\b\",\"i\").test(t);\n  });\n}\n\nconst out = [];\nfor(const it of items){\n  const job = it.json || {};\n  const title = (job.title || job.jobTitle || \"\").toString();\n  const desc  = (job.description || job.fullDescription || \"\").toString();\n  const company = (job.companyName || job.company || \"\").toString();\n  \n  const isMatch = containsKeyword(title) || containsKeyword(desc) || containsKeyword(company);\n\n  if(isMatch){\n    job._working_student = true;\n    out.push({ json: job });\n  } else {\n    // Option A: drop non-matching items by *not* pushing them\n    // (uncomment the next line to drop)\n    continue;\n\n    // Option B: keep but mark as filtered (useful for audit)\n    //job._working_student = false;\n    //out.push({ json: job });\n  }\n}\nreturn out;\n"
      },
